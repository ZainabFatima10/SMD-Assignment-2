        android:layout_marginTop="101dp">


        <ImageView
            android:id="@+id/pinkpfpRL4"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="100dp"
            android:contentDescription="@string/pfp_green"
            android:src="@drawable/pfp_pinkpurple" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/pinkpfpRL4"
            android:layout_marginStart="23dp"
            android:layout_marginTop="13dp"
            android:text="@string/lm"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/commentRL4"
            android:layout_width="280dp"
            android:layout_height="70dp"
            android:layout_alignStart="@id/pinkpfpRL4"
            android:layout_marginStart="50dp"
            android:layout_marginTop="100dp"
            android:background="@drawable/comment_design"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingTop="20dp"
            android:text="@string/comment_2"
            android:textColor="@color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/commentRL4"
            android:layout_marginStart="70dp"
            android:layout_marginBottom="45dp"
            android:gravity="center"
            android:text="@string/lina_marsh"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusupdateRL4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/commentRL4"
            android:layout_marginStart="20dp"
            android:layout_marginTop="175dp"
            android:text="@string/_1h"
            android:textSize="13sp"
            tools:ignore="SmallSp" />

        <TextView
            android:id="@+id/statusupdate2RL4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/statusupdateRL4"
            android:layout_marginStart="30dp"
            android:layout_marginTop="175dp"
            android:text="@string/like"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="SmallSp" />

        <TextView
            android:id="@+id/statusupdate3RL4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/statusupdate2RL4"
            android:layout_marginStart="40dp"
            android:layout_marginTop="175dp"
            android:text="@string/reply"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="SmallSp" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="300dp"
            android:layout_marginTop="155dp"
            android:contentDescription="@string/reaction_image"
            android:src="@drawable/reactionimg_2" />

    </RelativeLayout>

    <!-- Third Comment -->

    <RelativeLayout
        android:id="@+id/RL5"
        android:layout_width="match_parent"
        android:layout_height="192dp"
        android:layout_alignTop="@id/RL4"
        android:layout_marginStart="50dp"
        android:layout_marginTop="101dp">


        <ImageView
            android:id="@+id/pinkpfpRL5"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="100dp"
            android:contentDescription="@string/pfp_green"
            android:src="@drawable/pfp_blue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/pinkpfpRL5"
            android:layout_marginStart="23dp"
            android:layout_marginTop="13dp"
            android:text="@string/zr"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/commentRL5"
            android:layout_width="280dp"
            android:layout_height="70dp"
            android:layout_alignStart="@id/pinkpfpRL5"
            android:layout_marginStart="50dp"
            android:layout_marginTop="100dp"
            android:background="@drawable/comment_design"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:text="@string/comment_3"
            android:textColor="@color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/commentRL5"
            android:layout_marginStart="70dp"
            android:layout_marginBottom="45dp"
            android:gravity="center"
            android:text="@string/zain_raza"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusupdateRL5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/commentRL5"
            android:layout_marginStart="20dp"
            android:layout_marginTop="175dp"
            android:text="@string/_45m"
            android:textSize="13sp"
            tools:ignore="SmallSp" />

        <TextView
            android:id="@+id/statusupdate2RL5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/statusupdateRL5"
            android:layout_marginStart="40dp"
            android:layout_marginTop="175dp"
            android:text="@string/like"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="SmallSp" />

        <TextView
            android:id="@+id/statusupdate3RL5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/statusupdate2RL5"
            android:layout_marginStart="40dp"
            android:layout_marginTop="175dp"
            android:text="@string/reply"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="SmallSp" />

    </RelativeLayout>

    <TextView
        android:id="@+id/viewMoreReplies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/view_6_more_replies"
        android:layout_marginTop="410dp"
        android:layout_marginStart="60dp"
        android:textStyle="bold"/>

    <!-- Fourth Comment -->

    <RelativeLayout
        android:id="@+id/RL6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/viewMoreReplies"
        android:layout_marginTop="-70dp">

        <ImageView
            android:id="@+id/pinkpfpRL6"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/pfp_brown"
            android:contentDescription="@string/pfp_green"
            android:layout_marginStart="10dp"
            android:layout_marginTop="100dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/pinkpfpRL6"
            android:layout_marginTop="13dp"
            android:layout_marginStart="23dp"
            android:text="@string/ha"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/commentRL6"
            android:layout_width="180dp"
            android:layout_height="50dp"
            android:layout_alignStart="@id/pinkpfpRL6"
            android:layout_marginStart="50dp"
            android:layout_marginTop="100dp"
            android:background="@drawable/comment_design"
            android:text="@string/comment_4"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingTop="20dp"
            android:textColor="@color/black"/>

        <TextView
            android:layout_alignBottom="@id/commentRL6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/hamza_ali"
            android:layout_marginStart="70dp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="25dp"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/commentimg"
            android:layout_width="170dp"
            android:layout_height="100dp"
            app:cardCornerRadius="20dp"
            android:layout_alignTop="@id/commentRL6"
            android:layout_marginTop="55dp"
            android:layout_marginStart="65dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/oldimage"
                android:scaleType="centerCrop"
                android:contentDescription="@string/image"/>

        </androidx.cardview.widget.CardView>


        <TextView
            android:id="@+id/statusupdateRL6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/commentimg"
            android:layout_marginStart="20dp"
            android:layout_marginTop="260dp"
            android:text="@string/_1h"
            android:textSize="13sp"
            tools:ignore="SmallSp" />

        <TextView
            android:id="@+id/statusupdate2RL6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/statusupdateRL6"
            android:layout_marginStart="30dp"
            android:layout_marginTop="260dp"
            android:text="@string/like"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="SmallSp" />

        <TextView
            android:id="@+id/statusupdate3RL6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/statusupdate2RL6"
            android:layout_marginStart="40dp"
            android:layout_marginTop="260dp"
            android:text="@string/reply"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="SmallSp" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/RL7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/RL6"
        android:layout_marginTop="180dp">

        <ImageView
            android:id="@+id/pinkpfpRL7"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/pfp_uglybrown"
            android:contentDescription="@string/pfp_green"
            android:layout_marginStart="10dp"
            android:layout_marginTop="100dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/pinkpfpRL7"
            android:layout_marginTop="13dp"
            android:layout_marginStart="23dp"
            android:text="@string/mc"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/commentRL7"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:layout_alignStart="@id/pinkpfpRL7"
            android:layout_marginStart="50dp"
            android:layout_marginTop="100dp"
            android:background="@drawable/comment_design"
            android:text="@string/comment_5"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingTop="20dp"
            android:textColor="@color/black"/>

        <TextView
            android:layout_alignBottom="@id/commentRL7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/maya_chen"
            android:layout_marginStart="70dp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="25dp"/>

    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/one_sided_border_black_upper">

    <TextView
        android:id="@+id/replyingto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/replaying_to"
        android:layout_marginBottom="60dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp" />

        <TextView
            android:id="@+id/ak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aisha_khan"
            android:layout_alignStart="@id/replyingto"
            android:layout_marginTop="10dp"
            android:layout_marginStart="75dp"
            android:textColor="@color/black"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_alignStart="@id/ak"
            android:layout_marginTop="10dp"
            android:layout_marginStart="260dp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/camera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/camera_icon"
            android:layout_marginTop="50dp"
            android:layout_marginStart="20dp"/>

        <TextView
            android:id="@+id/prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/comment_design"
            android:text="@string/prompt"
            android:layout_alignStart="@id/camera"
            android:layout_marginTop="45dp"
            android:layout_marginStart="40dp"
            android:paddingStart="11dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:paddingEnd="200dp"/>

        <ImageView
            android:id="@+id/emoji_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/emoji_icon"
            android:layout_alignStart="@id/prompt"
            android:layout_marginTop="48dp"
            android:layout_marginStart="270dp"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/send_circle"
            android:layout_alignStart="@id/emoji_button"
            android:layout_marginStart="40dp"
            android:layout_marginTop="50dp"/>


    </RelativeLayout>



</RelativeLayout>