<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:id="@+id/RL1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/one_sided_black_border">

        <ImageView
            android:id="@+id/backarrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_back"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:paddingBottom="10dp"
            android:contentDescription="@string/back_arrow"/>

        <TextView
            android:id="@+id/comments_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/comments"
            android:textColor="@color/black"
            android:layout_alignStart="@id/backarrow"
            android:layout_marginStart="30dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/logo_text_bold"
            android:textSize="15sp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/most_relevant_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/most_relevant"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginStart="250dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/comment_design"
            android:padding="10dp"
            android:paddingStart="10dp"
            android:paddingEnd="40dp"/>

        <ImageView
            android:layout_alignTop="@id/most_relevant_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_down"
            android:layout_marginStart="355dp"
            android:layout_marginTop="5dp"
            android:scaleY="0.8"
            android:scaleX="0.8"
            android:contentDescription="@string/most_relevant"/>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/RL2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/RL1"
        android:layout_marginTop="50dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:background="@drawable/one_sided_black_border"
        android:paddingBottom="5dp">

        <ImageView
            android:id="@+id/reactions"
            android:layout_width="48dp"
            android:layout_height="24dp"
            android:src="@drawable/reaction_icons"
            android:layout_marginTop="7dp"
            android:contentDescription="@string/reaction_layout"/>

        <TextView
            android:id="@+id/reaction_number"
            android:layout_alignStart="@id/reactions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginTop="9dp"
            android:text="@string/_1_2k"
            android:textStyle="bold"
            android:textColor="@color/black"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/reaction_number"
            android:src="@drawable/right_button"
            android:layout_marginStart="310dp"
            android:layout_marginTop="5dp"
            android:contentDescription="@string/open_reactions_screen"/>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/RL3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/RL2"
        android:layout_marginTop="-50dp">

        <ImageView
            android:id="@+id/pinkpfp"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/pfp_darkpink"
            android:contentDescription="@string/pfp_green"
            android:layout_marginStart="10dp"
            android:layout_marginTop="100dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/pinkpfp"
            android:layout_marginTop="13dp"
            android:layout_marginStart="23dp"
            android:text="@string/ak"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/comment"
            android:layout_width="330dp"
            android:layout_height="70dp"
            android:layout_alignStart="@id/pinkpfp"
            android:layout_marginStart="50dp"
            android:layout_marginTop="100dp"
            android:background="@drawable/comment_design"
            android:text="@string/comment_1"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="40dp"
            android:paddingTop="20dp"
            android:textColor="@color/black"/>

        <TextView
            android:layout_alignBottom="@id/comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/aisha_khan"
            android:layout_marginStart="70dp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="45dp"/>

        <TextView
            android:id="@+id/statusupdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/comment"
            android:layout_marginStart="20dp"
            android:layout_marginTop="175dp"
            android:text="@string/_2h"
            android:textSize="13sp"
            tools:ignore="SmallSp" />

        <TextView
            android:id="@+id/statusupdate2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/statusupdate"
            android:layout_marginStart="30dp"
            android:layout_marginTop="175dp"
            android:text="@string/like"
            android:textSize="13sp"
            android:textColor="@color/SeaGreen"
            android:textStyle="bold"
            tools:ignore="SmallSp" />

        <TextView
            android:id="@+id/statusupdate3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/statusupdate2"
            android:layout_marginStart="40dp"
            android:layout_marginTop="175dp"
            android:text="@string/reply"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="SmallSp" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/reactionimg_1"
            android:contentDescription="@string/reaction_image"
            android:layout_marginStart="330dp"
            android:layout_marginTop="155dp" />

    </RelativeLayout>

    <!-- Second Comment -->

    <RelativeLayout
        android:id="@+id/RL4"
        android:layout_width="match_parent"
        android:layout_height="192dp"
        android:layout_alignTop="@id/RL3"
