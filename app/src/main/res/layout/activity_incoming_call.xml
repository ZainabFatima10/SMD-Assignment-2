<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teal">

    <TextView
        android:id="@+id/incomingType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"
        android:alpha="0.85"
        android:text="Incoming call"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <com.zainabfatima.i221064.util.AvatarView
        android:id="@+id/incomingAvatar"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="170dp" />

    <TextView
        android:id="@+id/incomingName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/incomingAvatar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="28dp"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="80dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnDecline"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_end_call"
            android:contentDescription="Decline"
            android:padding="22dp"
            android:src="@drawable/ic_call_end"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnAccept"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginStart="70dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#2EBD59"
            android:contentDescription="Accept"
            android:padding="22dp"
            android:src="@drawable/ic_call"
            android:tint="#FFFFFF" />
    </LinearLayout>
</RelativeLayout>
