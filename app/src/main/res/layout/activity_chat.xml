<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="4dp"
            android:padding="11dp"
            android:src="@drawable/ol_back"
            android:tint="@color/teal" />

        <RelativeLayout
            android:id="@+id/hdrAvatarBox"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="55dp">

            <com.zainabfatima.i221064.util.AvatarView
                android:id="@+id/hdrAvatar"
                android:layout_width="42dp"
                android:layout_height="42dp" />

            <View
                android:id="@+id/hdrOnlineDot"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:visibility="gone"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="-1dp"
                android:layout_marginBottom="0dp"
                android:background="@drawable/bg_online" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/hdrAvatarBox"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hdrName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/hdrStatus"
                android:text=""
                android:textColor="@color/ink2"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnInfo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:padding="9dp"
            android:src="@drawable/ol_info"
            android:tint="@color/teal" />

        <ImageView
            android:id="@+id/btnVideo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btnInfo"
            android:layout_marginEnd="6dp"
            android:padding="9dp"
            android:src="@drawable/ol_video"
            android:tint="@color/teal" />

        <ImageView
            android:id="@+id/btnCall"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@id/btnVideo"
            android:padding="9dp"
            android:src="@drawable/ol_call"
            android:tint="@color/teal" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <!-- messages -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messageList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/emptyChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="Say hi \uD83D\uDC4B"
            android:textColor="@color/ink2"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- replying to / editing banner -->
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/bannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ink2" />

        <TextView
            android:id="@+id/bannerCancel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="&#x2715;"
            android:textColor="@color/ink"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- composer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="7dp"
        android:paddingEnd="6dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/btnPlus"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="9dp"
            android:src="@drawable/ol_plus_circle"
            android:tint="@color/teal" />

        <ImageView
            android:id="@+id/btnCamera"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="9dp"
            android:src="@drawable/ol_camera"
            android:tint="@color/teal" />

        <ImageView
            android:id="@+id/btnGallery"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="9dp"
            android:src="@drawable/ol_image"
            android:tint="@color/teal" />

        <ImageView
            android:id="@+id/btnMic"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="9dp"
            android:src="@drawable/ol_mic"
            android:tint="@color/teal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_gray"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="17dp"
            android:paddingEnd="10dp">

            <EditText
                android:id="@+id/etMsg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="Aa"
                android:inputType="textCapSentences"
                android:maxLines="3"
                android:textColor="@color/ink"
                android:textColorHint="#8B867E"
                android:textSize="19sp" />

            <ImageView
                android:id="@+id/btnEmoji"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="2dp"
                android:src="@drawable/ol_emoji"
                android:tint="@color/teal" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="8dp"
            android:src="@drawable/ol_thumb"
            android:tint="@color/teal" />
    </LinearLayout>
</LinearLayout>
