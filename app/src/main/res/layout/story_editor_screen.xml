<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nearblack">

    <androidx.cardview.widget.CardView
        android:id="@+id/story_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="100dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/extra5"
                android:scaleType="centerCrop"
                android:contentDescription="@string/story_image"/>

            <ImageView
                android:id="@+id/close_button"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:padding="12dp"
                android:src="@drawable/cancel_icon_white"
                android:background="@drawable/translucent_circle"
                android:contentDescription="@string/close_icon"/>

            <LinearLayout
                android:id="@+id/editor_tools"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <ImageView
        android:id="@+id/tool_tag"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:padding="12dp"
                    android:src="@drawable/person_add_white"
                    android:background="@drawable/translucent_circle"
                    android:contentDescription="@string/tag_people_icon"/>

                <TextView
        android:id="@+id/tool_text"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:text="@string/text_tool"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:background="@drawable/translucent_circle"/>

                <ImageView
        android:id="@+id/tool_emoji"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:padding="11dp"
                    android:src="@drawable/emoji_icon_white"
                    android:background="@drawable/translucent_circle"
                    android:contentDescription="@string/emoji_icon"/>

                <ImageView
        android:id="@+id/tool_music"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:padding="12dp"
                    android:src="@drawable/music_icon"
                    android:background="@drawable/translucent_circle"
                    android:contentDescription="@string/music_icon"/>

                <ImageView
        android:id="@+id/tool_effects"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:padding="12dp"
                    android:src="@drawable/sparkle_icon"
                    android:background="@drawable/translucent_circle"
                    android:contentDescription="@string/effects_icon"/>

            </LinearLayout>

            <TextView
                android:id="@+id/saturday_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="36dp"
                android:layout_marginTop="410dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:rotation="2"
                android:background="@drawable/red_orange_label"
                android:text="@string/saturday_plans"
                android:textColor="@color/white"
                android:fontFamily="@font/logo_text_bold"
                android:textSize="22sp"/>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/share_bar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
        android:id="@+id/pill_your_story"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/dark_pill">

            <RelativeLayout
                android:layout_width="28dp"
                android:layout_height="28dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/seagreen_oval"
                    android:contentDescription="@string/sea_green_default_profile_picture"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/jw"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="9sp"/>

            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/your_story"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="15sp"/>

        </LinearLayout>

        <LinearLayout
        android:id="@+id/pill_close_friends"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/dark_pill">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="6dp"
                android:src="@drawable/star_icon_white"
                android:background="@drawable/green_circle"
                android:contentDescription="@string/star_icon"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/close_friends"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="15sp"/>

        </LinearLayout>

        <ImageView
        android:id="@+id/btn_next"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:padding="15dp"
            android:src="@drawable/arrow_forward_white"
            android:background="@drawable/seagreen_circle"
            android:contentDescription="@string/next_arrow"/>

    </LinearLayout>

</RelativeLayout>
