<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/RL1"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/one_sided_black_border">

        <TextView
            android:id="@+id/cancel_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"
            android:text="@string/cancel"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/recents_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:drawableEnd="@drawable/arrow_down"
            android:fontFamily="@font/logo_text_bold"
            android:text="@string/recents"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/most_relevant_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="15dp"
            android:padding="6dp"
            android:text="Next"
            android:textColor="@color/SeaGreen"
            android:textStyle="bold" />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/current_picture"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:background="@color/LightBeige">

        <ImageView
            android:id="@+id/previewImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <Button
            android:id="@+id/btnSelectMultiple"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/button_border_log_in"
            android:drawableStart="@drawable/copy_icon"
            android:drawablePadding="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Select Multiple"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="Allow access to your photos to pick from the gallery."
        android:textColor="@color/gray"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnSystemPicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/porcelain_interior_seagreen_border"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="Open system photo picker"
        android:textAllCaps="false"
        android:textColor="@color/SeaGreen"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/galleryGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
