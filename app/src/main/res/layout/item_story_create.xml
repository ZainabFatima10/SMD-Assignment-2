<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/createStoryOption"
    android:layout_width="90dp"
    android:layout_height="160dp"
    android:layout_marginEnd="10dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="115dp"
            android:background="@color/lightblue">

            <com.zainabfatima.i221064.util.AvatarView
                android:id="@+id/createAvatar"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/logo_text_bold"
            android:gravity="center"
            android:paddingTop="8dp"
            android:text="@string/create_story"
            android:textColor="@color/black"
            android:textSize="10sp"
            tools:ignore="SmallSp"
            xmlns:tools="http://schemas.android.com/tools" />
    </LinearLayout>

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="104dp"
        android:background="@drawable/seagreen_interior_white_border"
        android:contentDescription="@null"
        android:padding="4dp"
        android:src="@drawable/add_icon" />
</androidx.cardview.widget.CardView>
