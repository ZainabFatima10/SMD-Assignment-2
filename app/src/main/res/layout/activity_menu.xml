<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <include layout="@layout/tabbar_menu" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/cardProfile"
                android:layout_width="match_parent"
                android:layout_height="71dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="13dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_card12"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/avJW"
                    style="@style/AvatarText"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="13dp"
                    android:backgroundTint="#0B5F61"
                    android:text="JW"
                    android:textSize="19sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/avJW"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="-0.02"
                        android:text="Jacob West"
                        android:textColor="@color/ink"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="See your profile"
                        android:textColor="@color/ink2"
                        android:textSize="16sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ol_chev_right"
                    android:tint="@color/ink" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="9dp"
                android:gravity="center_vertical"
                android:text="All shortcuts"
                android:textColor="@color/ink2"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="11dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardMemories"
                    android:layout_width="0dp"
                    android:layout_height="81dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card12"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:paddingStart="13dp"
                    android:paddingTop="13dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ol_clock"
                        android:tint="@color/teal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Memories"
                        android:textColor="@color/ink"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardSaved"
                    android:layout_width="0dp"
                    android:layout_height="81dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card12"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:paddingStart="13dp"
                    android:paddingTop="13dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ol_bookmark"
                        android:tint="#7B4F7F" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Saved"
                        android:textColor="@color/ink"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardGroups"
                    android:layout_width="0dp"
                    android:layout_height="81dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card12"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:paddingStart="13dp"
                    android:paddingTop="13dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ol_people"
                        android:tint="#4B4F93" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Groups"
                        android:textColor="@color/ink"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardMarket"
                    android:layout_width="0dp"
                    android:layout_height="81dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card12"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:paddingStart="13dp"
                    android:paddingTop="13dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ol_store"
                        android:tint="#2F6E4E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Marketplace"
                        android:textColor="@color/ink"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardFriends"
                    android:layout_width="0dp"
                    android:layout_height="81dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card12"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:paddingStart="13dp"
                    android:paddingTop="13dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ol_person"
                        android:tint="@color/teal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Friends"
                        android:textColor="@color/ink"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardEvents"
                    android:layout_width="0dp"
                    android:layout_height="81dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card12"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:paddingStart="13dp"
                    android:paddingTop="13dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ol_calendar"
                        android:tint="@color/rust" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Events"
                        android:textColor="@color/ink"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnSeeMore"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="13dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_cream12"
                android:gravity="center"
                android:text="See more"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/line" />

            <RelativeLayout
                android:id="@+id/rowHelp"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:paddingStart="21dp"
                android:paddingEnd="26dp">

                <ImageView
                    android:id="@+id/icHelp"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/pill"
                    android:padding="9dp"
                    android:src="@drawable/ol_help"
                    android:tint="@color/ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="13dp"
                    android:layout_toEndOf="@id/icHelp"
                    android:text="Help &amp; support"
                    android:textColor="@color/ink"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/arrowHelp"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ol_chev_down"
                    android:tint="@color/ink2" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/subHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="72dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/subHelp1"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:text="Help centre"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/subHelp2"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:text="Report a problem"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/line" />

            <RelativeLayout
                android:id="@+id/rowSettings"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:paddingStart="21dp"
                android:paddingEnd="26dp">

                <ImageView
                    android:id="@+id/icSettings"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/pill"
                    android:padding="9dp"
                    android:src="@drawable/ol_settings"
                    android:tint="@color/ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="13dp"
                    android:layout_toEndOf="@id/icSettings"
                    android:text="Settings &amp; privacy"
                    android:textColor="@color/ink"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/arrowSettings"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ol_chev_down"
                    android:tint="@color/ink2" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/subSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="72dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/subSet1"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:text="Settings"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/subSet2"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:text="Privacy checkup"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/line" />

            <RelativeLayout
                android:id="@+id/rowSmd"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:paddingStart="21dp"
                android:paddingEnd="26dp">

                <ImageView
                    android:id="@+id/icSmd"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/pill"
                    android:padding="9dp"
                    android:src="@drawable/ol_apps"
                    android:tint="@color/ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="13dp"
                    android:layout_toEndOf="@id/icSmd"
                    android:text="Also from SMD"
                    android:textColor="@color/ink"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/arrowSmd"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ol_chev_down"
                    android:tint="@color/ink2" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/subSmd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="72dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/subSmd1"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:text="SMD Studio"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/subSmd2"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:text="SMD Learn"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_cream12"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ol_logout"
                    android:tint="@color/ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Log out"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
