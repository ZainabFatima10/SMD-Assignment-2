<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <include layout="@layout/tabbar_market" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnSell"
                android:layout_width="0dp"
                android:layout_height="39dp"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_gray"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ol_pencil"
                    android:tint="@color/ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="Sell"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnCategories"
                android:layout_width="0dp"
                android:layout_height="39dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_gray"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ol_apps"
                    android:tint="@color/ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="Categories"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:letterSpacing="-0.02"
                        android:text="Today\'s picks"
                        android:textColor="@color/ink"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/btnLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ol_pin"
                            android:tint="@color/teal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Karachi · 40 km"
                            android:textColor="@color/teal"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/p1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="185dp">

                <ImageView
                    android:id="@+id/p1_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_round12"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/art_green" />

            <TextView
                android:id="@+id/p1_tag"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="9dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_tag_new"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="JUST LISTED"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:id="@+id/p1_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Rs 45,000"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/p1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Road bike, 21-speed"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clifton"
                android:textColor="@color/ink2"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/p2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="185dp">

                <ImageView
                    android:id="@+id/p2_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_round12"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/art_pink" />
            </RelativeLayout>

            <TextView
                android:id="@+id/p2_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Rs 8,500"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/p2_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rattan armchair"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DHA Phase 6"
                android:textColor="@color/ink2"
                android:textSize="13sp" />
        </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/p3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="185dp">

                <ImageView
                    android:id="@+id/p3_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_round12"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/art_blue" />
            </RelativeLayout>

            <TextView
                android:id="@+id/p3_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Rs 15,000"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/p3_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solid wood study desk"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gulshan"
                android:textColor="@color/ink2"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/p4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="185dp">

                <ImageView
                    android:id="@+id/p4_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_round12"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/art_sand" />

            <TextView
                android:id="@+id/p4_tag"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="9dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_tag_new"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="JUST LISTED"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:id="@+id/p4_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Rs 3,200"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/p4_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ceramic plant pots, set of 3"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saddar"
                android:textColor="@color/ink2"
                android:textSize="13sp" />
        </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- drawer: Categories -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.02"
            android:paddingStart="20dp"
            android:paddingTop="40dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp"
            android:text="Categories"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <TextView
            android:id="@+id/cat1"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Vehicles"
            android:textColor="@color/ink"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/cat2"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Property rentals"
            android:textColor="@color/ink"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/cat3"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Furniture"
            android:textColor="@color/ink"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/cat4"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Electronics"
            android:textColor="@color/ink"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/cat5"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Clothing"
            android:textColor="@color/ink"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/cat6"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Home &amp; garden"
            android:textColor="@color/ink"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/cat7"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Hobbies"
            android:textColor="@color/ink"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/cat8"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Sports &amp; outdoors"
            android:textColor="@color/ink"
            android:textSize="17sp" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
