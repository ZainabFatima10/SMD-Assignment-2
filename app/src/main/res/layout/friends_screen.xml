            android:layout_marginTop="2dp"
            android:text="@string/bilal_ahmed"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="2dp"
            android:text="@string/_1w"
            android:textColor="@color/gray"
            android:textSize="12sp"/>

        <RelativeLayout
            android:id="@+id/request2_mutual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/request2_name"
            android:layout_alignTop="@id/request2_name"
            android:layout_marginTop="25dp">

            <ImageView
                android:id="@+id/request2_mutual1"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/pfp_purple"
                android:contentDescription="@string/mutual_friends_icon"/>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignStart="@id/request2_mutual1"
                android:layout_marginStart="11dp"
                android:src="@drawable/pfp_brown"
                android:contentDescription="@string/mutual_friends_icon"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignStart="@id/request2_mutual1"
                android:layout_marginStart="34dp"
                android:text="@string/mutual_14"
                android:textColor="@color/gray"
                android:textSize="13sp"/>

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_alignStart="@id/request2_name"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/request2_name"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="52dp"
            android:orientation="horizontal">

            <TextView
        android:id="@+id/confirm2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:background="@drawable/seagreen_button_10"
                android:text="@string/confirm"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <TextView
        android:id="@+id/delete2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/beige_button_10"
                android:text="@string/delete"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp"/>

        </LinearLayout>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/request3"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_alignTop="@id/request2"
        android:layout_marginTop="114dp">

        <RelativeLayout
            android:id="@+id/request3_pfp"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginStart="18dp"
            android:layout_centerVertical="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/pfp_green"
                android:scaleX="1.2"
                android:scaleY="1.2"
                android:contentDescription="@string/pfp_green"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/nf"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="26sp"/>

        </RelativeLayout>

        <TextView
            android:id="@+id/request3_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/request3_pfp"
            android:layout_marginStart="98dp"
            android:layout_marginTop="2dp"
            android:text="@string/noor_fatima"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="2dp"
            android:text="@string/_2w"
            android:textColor="@color/gray"
            android:textSize="12sp"/>

        <RelativeLayout
            android:id="@+id/request3_mutual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/request3_name"
            android:layout_alignTop="@id/request3_name"
            android:layout_marginTop="25dp">

            <ImageView
                android:id="@+id/request3_mutual1"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/pfp_purple"
                android:contentDescription="@string/mutual_friends_icon"/>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignStart="@id/request3_mutual1"
                android:layout_marginStart="11dp"
                android:src="@drawable/pfp_brown"
                android:contentDescription="@string/mutual_friends_icon"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignStart="@id/request3_mutual1"
                android:layout_marginStart="34dp"
                android:text="@string/mutual_3"
                android:textColor="@color/gray"
                android:textSize="13sp"/>

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_alignStart="@id/request3_name"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/request3_name"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="52dp"
            android:orientation="horizontal">

            <TextView
        android:id="@+id/confirm3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:background="@drawable/seagreen_button_10"
                android:text="@string/confirm"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <TextView
        android:id="@+id/delete3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/beige_button_10"
                android:text="@string/delete"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp"/>

        </LinearLayout>

