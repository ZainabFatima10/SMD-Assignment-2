    </RelativeLayout>

    <View
        android:id="@+id/requests_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignTop="@id/request4"
        android:layout_marginTop="114dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:background="@color/LightBeige"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/requests_divider"
        android:layout_marginTop="22dp"
        android:layout_marginStart="18dp"
        android:text="@string/people_you_may_know"
        android:textColor="@color/black"
        android:fontFamily="@font/logo_text_bold"
        android:textSize="20sp"/>

</RelativeLayout>
