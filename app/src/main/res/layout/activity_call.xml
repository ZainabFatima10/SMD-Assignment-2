<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teal">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:alpha="0.8"
            android:src="@drawable/ic_lock"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:alpha="0.8"
            android:text="End-to-end encrypted"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:id="@+id/halo1"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="150dp"
        android:background="@drawable/bg_halo" />

    <View
        android:id="@+id/halo2"
        android:layout_width="232dp"
        android:layout_height="232dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="164dp"
        android:background="@drawable/bg_halo" />

    <TextView
        android:id="@+id/callAvatar"
        android:layout_width="204dp"
        android:layout_height="204dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="178dp"
        android:background="@drawable/bg_call_avatar"
        android:gravity="center"
        android:text="AM"
        android:textColor="#FFFFFF"
        android:textSize="64sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/nameRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/halo1"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ammi"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/heart"
            android:padding="5dp"
            android:src="@drawable/ic_heart"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/nameRow"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:text="03:12"
        android:textColor="#E6FFFFFF"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="64dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnNotes"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#33FFFFFF"
            android:padding="18dp"
            android:src="@drawable/ic_list"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnMute"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#33FFFFFF"
            android:padding="18dp"
            android:src="@drawable/ic_mic"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnEnd"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_end_call"
            android:padding="24dp"
            android:src="@drawable/ic_call_end"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnSpeaker"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#33FFFFFF"
            android:padding="18dp"
            android:src="@drawable/ic_speaker"
            android:tint="#FFFFFF" />
    </LinearLayout>
</RelativeLayout>
