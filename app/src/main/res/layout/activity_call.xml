<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teal">

    <FrameLayout
        android:id="@+id/remoteVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/localVideo"
        android:layout_width="110dp"
        android:layout_height="160dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="16dp"
        android:elevation="6dp"
        android:visibility="gone" />


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:alpha="0.8"
            android:src="@drawable/ic_lock"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:alpha="0.8"
            android:text="Kinnect call"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:id="@+id/halo1"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="150dp"
        android:background="@drawable/bg_halo" />

    <View
        android:id="@+id/halo2"
        android:layout_width="232dp"
        android:layout_height="232dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="164dp"
        android:background="@drawable/bg_halo" />

    <com.zainabfatima.i221064.util.AvatarView
        android:id="@+id/callAvatar"
        android:layout_width="204dp"
        android:layout_height="204dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="178dp" />

    <LinearLayout
        android:id="@+id/nameRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/halo1"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/callName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />


    </LinearLayout>

    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/nameRow"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:text="Calling…"
        android:textColor="#E6FFFFFF"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="64dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnNotes"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#33FFFFFF"
            android:padding="18dp"
            android:src="@drawable/ic_list"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnMute"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#33FFFFFF"
            android:padding="18dp"
            android:src="@drawable/ic_mic"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnEnd"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_end_call"
            android:padding="24dp"
            android:src="@drawable/ic_call_end"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnSpeaker"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#33FFFFFF"
            android:padding="18dp"
            android:src="@drawable/ic_speaker"
            android:tint="#FFFFFF" />
    </LinearLayout>
</RelativeLayout>
