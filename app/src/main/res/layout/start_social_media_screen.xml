<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/RL1"
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/logo_text_bold"
            android:text="@string/kinnect"
            android:textColor="@color/SeaGreen"
            android:textSize="25sp" />

        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/messageFrame"
            android:background="@drawable/circle_icon"
            android:contentDescription="@string/search_icon"
            android:padding="8dp"
            android:src="@drawable/search_icon" />

        <FrameLayout
            android:id="@+id/messageFrame"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/messageIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_icon"
                android:contentDescription="@string/message_icon"
                android:padding="8dp"
                android:src="@drawable/message_circle_check" />

            <TextView
                android:id="@+id/tvUnreadBadge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="@drawable/circle_text"
                android:gravity="center"
                android:minWidth="16dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:visibility="gone"
                tools:ignore="SmallSp" />
        </FrameLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/LL1"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/one_sided_border_black"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/one_sided_border_seagreen"
            android:contentDescription="@string/home_icon"
            android:padding="10dp"
            android:src="@drawable/home" />

        <ImageView
            android:id="@+id/tabPeople"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/people_icon"
            android:padding="10dp"
            android:src="@drawable/people" />

        <ImageView
            android:id="@+id/tabShop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/shop_icon"
            android:padding="10dp"
            android:src="@drawable/shop" />

        <ImageView
            android:id="@+id/tabNotif"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/notification_icon"
            android:padding="10dp"
            android:src="@drawable/notifications" />

        <ImageView
            android:id="@+id/tabMore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/more_icon"
            android:padding="10dp"
            android:src="@drawable/more_symbol" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/feed"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />
</LinearLayout>
