<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white">

    <RelativeLayout
        android:id="@+id/RL1"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentStart="true">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/logo_text_bold"
        android:text="@string/kinnect"
        android:textColor="@color/SeaGreen"
        android:textSize="25sp"
        android:layout_toStartOf="@id/messageIcon"
        android:layout_marginEnd="250dp"/>

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/search_icon"
        android:background="@drawable/circle_icon"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="50dp"
        android:padding="5dp"
        android:id="@+id/btnSearch"
        android:contentDescription="@string/search_icon"/>

    <ImageView
        android:id="@+id/messageIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/message_circle_check"
        android:background="@drawable/circle_icon"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="5dp"
        android:padding="5dp"
        android:contentDescription="@string/message_icon"/>

    <TextView
        android:layout_width="11dp"
        android:layout_height="10dp"
        android:gravity="center"
        android:background="@drawable/circle_text"
        android:textColor="@color/white"
        android:text="@string/_3"
        android:textSize="8sp"
        android:layout_alignStart="@id/messageIcon"
        android:layout_marginStart="25dp"
        android:layout_marginTop="10dp"
        tools:ignore="SmallSp" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/LL1"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignTop="@id/RL1"
        android:background="@drawable/one_sided_border_black"
        android:layout_marginTop="50dp">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/one_sided_border_seagreen"
            android:paddingTop="4dp"
            android:paddingBottom="17dp"
            android:src="@drawable/home"
            android:id="@+id/tabHome"
        android:contentDescription="@string/home_icon"/>

        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/people"
            android:id="@+id/tabPeople"
        android:contentDescription="@string/people_icon"/>

        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/shop"
            android:id="@+id/tabShop"
        android:contentDescription="@string/shop_icon"/>

        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/notifications"
            android:id="@+id/tabNotif"
        android:contentDescription="@string/notification_icon"/>

        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/more_symbol"
            android:id="@+id/tabMore"
        android:contentDescription="@string/more_icon"/>

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/LL1"
        android:layout_marginTop="50dp">

        <ImageView
            android:id="@+id/seagreenpfp"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="15dp"
            android:src="@drawable/pfp_seagreen"
            android:contentDescription="@string/sea_green_default_profile_picture"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/jw"
            android:textColor="@color/white"
            android:layout_alignStart="@id/seagreenpfp"
            android:layout_alignEnd="@id/seagreenpfp"
            android:layout_alignTop="@id/seagreenpfp"
            android:layout_alignBottom="@id/seagreenpfp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="14dp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/search_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/what_s_on_your_mind_jacob"
            android:layout_alignStart="@id/seagreenpfp"
            android:layout_marginStart="60dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/basic_white_interior_black_border"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:paddingEnd="60dp"
            android:paddingStart="15dp"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/search_bar"
            android:id="@+id/btnImagePost"
        android:contentDescription="@string/image_icon"
            android:src="@drawable/image_icon_actual"
            android:layout_marginStart="290dp"
            android:layout_marginTop="12dp"/>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/coloredLL1"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="@color/LightBeige"
        android:layout_alignTop="@id/RL1"
        android:layout_marginTop="160dp"
        android:orientation="horizontal"/>

    <RelativeLayout
        android:id="@+id/multicardview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignTop="@id/coloredLL1"
        android:layout_marginTop="30dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/createStoryOption"
            android:layout_width="90dp"
            android:layout_height="160dp"
            app:cardCornerRadius="10dp"
            android:layout_marginStart="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@color/lightblue"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/seagreenpfp2"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/pfp_seagreen"
                        android:contentDescription="@string/sea_green_default_profile_picture" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/jw"
                        android:textColor="@color/white"
                        android:layout_alignStart="@id/seagreenpfp2"
                        android:layout_alignEnd="@id/seagreenpfp2"
                        android:layout_alignTop="@id/seagreenpfp2"
                        android:layout_alignBottom="@id/seagreenpfp2"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="26dp"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </RelativeLayout>
            </RelativeLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/add_icon"
                android:layout_alignTop="@id/seagreenpfp2"
                android:background="@drawable/seagreen_interior_white_border"
                android:layout_marginStart="35dp"
                android:layout_marginTop="110dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="135dp"
                android:layout_marginStart="8dp"
                android:textAlignment="center"
                android:text="@string/create_story"
                android:fontFamily="@font/logo_text_bold"
                android:textColor="@color/black"
                android:textSize="10sp"
                tools:ignore="SmallSp" />

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/story1"
            android:layout_width="90dp"
            android:layout_height="160dp"
            app:cardCornerRadius="10dp"
            android:layout_alignStart="@id/createStoryOption"
            android:layout_marginStart="110dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/secondstory"
                android:scaleX="3"
                android:scaleY="3"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/filled_circle"/>

                <ImageView
                    android:id="@+id/pfp1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/pfp_green"
                    android:background="@drawable/white_border"
                    android:contentDescription="@string/pfp_green"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="5dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@id/pfp1"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="11dp"
                    android:text="OF"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"/>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_alignParentBottom="true"
                    android:background="#aa000000"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="140dp"
                    android:layout_marginStart="13dp"
                    android:text="Omar Farooq"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

            </RelativeLayout>


        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/story2"
            android:layout_width="90dp"
            android:layout_height="160dp"
            app:cardCornerRadius="10dp"
            android:layout_alignStart="@id/story1"
            android:layout_marginStart="110dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/firststory"
                android:scaleX="3"
                android:scaleY="3"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/filled_circle"/>

                <ImageView
                    android:id="@+id/pfp2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/pfp_purple"
                    android:background="@drawable/white_border"
                    android:contentDescription="@string/pfp_green"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="5dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@id/pfp2"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="12dp"
                    android:text="SI"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_alignParentBottom="true"
                    android:background="#aa000000"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="140dp"
                    android:layout_marginStart="15dp"
                    android:text="Sara Iqbal"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/story3"
            android:layout_width="wrap_content"
            android:layout_height="160dp"
            android:layout_alignStart="@id/story2"
            android:layout_marginStart="110dp"
            app:cardCornerRadius="10dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/thirdstory"
                android:scaleX="3"
                android:scaleY="3"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/filled_circle"/>

                <ImageView
                    android:id="@+id/pfp3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/pfp_brown"
                    android:background="@drawable/white_border"
                    android:contentDescription="@string/pfp_green"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="5dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@id/pfp3"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="10dp"
                    android:text="HA"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_alignParentBottom="true"
                    android:background="#aa000000"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="140dp"
                    android:layout_marginStart="15dp"
                    android:text="Hamza"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/coloredLL2"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="@color/LightBeige"
        android:layout_alignTop="@id/multicardview"
        android:layout_marginTop="180dp"
        android:orientation="horizontal"/>

    <RelativeLayout
        android:id="@+id/RL2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/coloredLL2"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/pfp4"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/pfp_pinkpurple"
            android:background="@drawable/white_border"
            android:contentDescription="@string/pfp_green"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/pfp4"
            android:layout_marginTop="13dp"
            android:layout_marginStart="23dp"
            android:text="LM"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/textp1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/pfp4"
            android:layout_marginStart="50dp"
            android:layout_marginTop="12dp"
            android:text="Lina Marsh"
            android:textStyle="bold"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/textp2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/textp1"
            android:layout_marginStart="75dp"
            android:layout_marginTop="12dp"
            android:text="is at"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/textp3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/textp2"
            android:layout_marginStart="32dp"
            android:layout_marginTop="12dp"
            android:text="Clifton Beach"
            android:textStyle="bold"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/statusupdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/pfp4"
            android:layout_marginStart="50dp"
            android:layout_marginTop="30dp"
            android:text="2h &#x2022;"
            android:textSize="10sp"
            android:textColor="@color/black"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/statusupdate"
            android:layout_marginTop="32dp"
            android:layout_marginStart="20dp"
            android:src="@drawable/web"/>

        <ImageView
            android:id="@+id/horizontal_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/textp3"
            android:layout_marginTop="20dp"
            android:layout_marginStart="150dp"
            android:src="@drawable/more_horiz_icon"/>

        <ImageView
            android:id="@+id/cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/horizontal_more"
            android:layout_marginTop="25dp"
            android:layout_marginStart="60dp"
            android:src="@drawable/cancel_icon"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/pfp4"
            android:layout_marginTop="50dp"
            android:layout_marginStart="12dp"
            android:text="Sunset walk with the crew. Worth every grain of sand in my shoes."
            android:textSize="15sp"
            android:layout_marginEnd="40dp"
            android:textColor="@color/black"/>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/RL3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/RL2"
        android:layout_marginTop="100dp">

        <ImageView
            android:id="@+id/n1"
            android:layout_width="190dp"
            android:layout_height="180dp"
            android:src="@drawable/n1"
            android:scaleY="1.4"/>

        <ImageView
            android:id="@+id/n2"
            android:layout_width="225dp"
            android:layout_height="87dp"
            android:src="@drawable/n2"
            android:layout_alignStart="@id/n1"
            android:layout_marginStart="195dp"
            android:scaleType="centerCrop"/>

        <ImageView
            android:id="@+id/n3"
            android:layout_width="220dp"
            android:layout_height="89dp"
            android:src="@drawable/n3"
            android:layout_alignStart="@id/n1"
            android:layout_marginTop="90dp"
            android:layout_marginStart="195dp"
            android:scaleType="centerCrop"/>

        <ImageView
            android:id="@+id/n4"
            android:layout_width="220dp"
            android:layout_height="89dp"
            android:layout_alignStart="@id/n1"
            android:layout_marginTop="90dp"
            android:layout_marginStart="195dp"
            android:background="#aa000000"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/n2"
            android:layout_marginStart="290dp"
            android:layout_marginTop="120dp"
            android:text="+4"
            android:textColor="@color/white"
            android:textStyle="bold"/>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/RL4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/RL3"
        android:layout_marginTop="180dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:background="@drawable/one_sided_black_border"
        android:paddingBottom="5dp">

        <ImageView
            android:id="@+id/reactions"
            android:layout_width="48dp"
            android:layout_height="24dp"
            android:src="@drawable/reaction_icons"
            android:layout_marginTop="7dp" />

        <TextView
            android:layout_alignStart="@id/reactions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginTop="7dp"
            android:text="@string/aisha_and_1_2k_others_86_comments_x2022_12_shares"/>

    </RelativeLayout>

    <RelativeLayout
        android:layout_alignTop="@id/RL4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginStart="15dp">

        <ImageView
            android:id="@+id/likeimg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/like"
            android:layout_marginStart="5dp"/>

        <TextView
            android:id="@+id/likeword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@color/gray"
            android:text="@string/like"
            android:layout_alignStart="@id/likeimg"
            android:layout_marginTop="2dp"
            android:layout_marginStart="27dp"/>

        <ImageView
            android:id="@+id/commentimg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/comment"
            android:layout_alignStart="@id/likeword"
            android:layout_marginStart="110dp"/>

        <TextView
            android:id="@+id/commentword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@color/gray"
            android:text="@string/comment"
            android:layout_alignStart="@id/commentimg"
            android:layout_marginStart="27dp"/>

        <ImageView
            android:id="@+id/shareimg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/share"
            android:layout_alignStart="@id/commentword"
            android:layout_marginStart="140dp"/>

        <TextView
            android:id="@+id/shareword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@color/gray"
            android:text="@string/share"
            android:layout_alignStart="@id/shareimg"
            android:layout_marginStart="27dp"/>


    </RelativeLayout>

</RelativeLayout>
