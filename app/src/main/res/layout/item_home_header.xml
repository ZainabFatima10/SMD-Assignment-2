<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- composer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <com.zainabfatima.i221064.util.AvatarView
            android:id="@+id/seagreenpfp"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="5dp" />

        <TextView
            android:id="@+id/search_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/basic_white_interior_black_border"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="15dp"
            android:paddingTop="8dp"
            android:paddingEnd="15dp"
            android:paddingBottom="8dp"
            android:text="@string/what_s_on_your_mind_jacob" />

        <ImageView
            android:id="@+id/btnImagePost"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/image_icon"
            android:padding="8dp"
            android:src="@drawable/image_icon_actual" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="@color/LightBeige" />

    <!-- stories: "Create story" first, then friends -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/storiesRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="@color/LightBeige" />

    <TextView
        android:id="@+id/tvEmptyFeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="30dp"
        android:text="No posts yet.\nAdd friends or share something to fill your feed."
        android:textColor="@color/gray"
        android:visibility="gone" />
</LinearLayout>
