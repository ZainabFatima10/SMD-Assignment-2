<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nearblack">

    <androidx.cardview.widget.CardView
        android:id="@+id/camera_preview_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="110dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/camera_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/extra5"
                android:scaleType="centerCrop"
                android:contentDescription="@string/camera_preview"/>

            <ImageView
                android:id="@+id/settings_button"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:padding="12dp"
                android:src="@drawable/sun_icon"
                android:background="@drawable/translucent_circle"
                android:contentDescription="@string/settings_icon"/>

            <ImageView
                android:id="@+id/close_button"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"
                android:padding="12dp"
                android:src="@drawable/cancel_icon_white"
                android:background="@drawable/translucent_circle"
                android:contentDescription="@string/close_icon"/>

            <RelativeLayout
                android:id="@+id/camera_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/shutter_button"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/shutter_button"
                    android:contentDescription="@string/shutter_button"/>

                <ImageView
                    android:id="@+id/flash_button"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_toStartOf="@id/shutter_button"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="24dp"
                    android:padding="13dp"
                    android:src="@drawable/flash_icon"
                    android:background="@drawable/translucent_circle"
                    android:contentDescription="@string/flash_icon"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/gallery_thumbnail"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_toStartOf="@id/flash_button"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="24dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/extra3"
                            android:scaleType="centerCrop"
                            android:contentDescription="@string/gallery_thumbnail"/>

                    </androidx.cardview.widget.CardView>

                </androidx.cardview.widget.CardView>

                <ImageView
                    android:id="@+id/flip_button"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_toEndOf="@id/shutter_button"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="24dp"
                    android:padding="12dp"
                    android:src="@drawable/flip_camera_icon"
                    android:background="@drawable/translucent_circle"
                    android:contentDescription="@string/flip_camera"/>

                <ImageView
                    android:id="@+id/emoji_button"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_toEndOf="@id/flip_button"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="24dp"
                    android:padding="11dp"
                    android:src="@drawable/emoji_icon_white"
                    android:background="@drawable/translucent_circle"
                    android:contentDescription="@string/emoji_icon"/>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignTop="@id/emoji_button"
                    android:layout_alignEnd="@id/emoji_button"
                    android:layout_marginTop="-3dp"
                    android:layout_marginEnd="-3dp"
                    android:src="@drawable/red_dot_white_border"/>

            </RelativeLayout>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/camera_modes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="38dp"
        android:orientation="horizontal"
        android:gravity="top|center_horizontal">

        <TextView
        android:id="@+id/mode_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mode_text"
            android:textColor="@color/fadedwhite"
            android:textStyle="bold"
            android:textSize="13sp"
            android:letterSpacing="0.1"
            android:layout_marginEnd="22dp"/>

        <TextView
        android:id="@+id/mode_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mode_live"
            android:textColor="@color/fadedwhite"
            android:textStyle="bold"
            android:textSize="13sp"
            android:letterSpacing="0.1"
            android:layout_marginEnd="22dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="22dp">

            <TextView
        android:id="@+id/mode_story"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_story"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.1"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:background="@color/white"/>

        </LinearLayout>

        <TextView
        android:id="@+id/mode_post"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mode_post"
            android:textColor="@color/fadedwhite"
            android:textStyle="bold"
            android:textSize="13sp"
            android:letterSpacing="0.1"
            android:layout_marginEnd="22dp"/>

        <TextView
        android:id="@+id/mode_boomerang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mode_boomerang"
            android:textColor="@color/fadedwhite"
            android:textStyle="bold"
            android:textSize="13sp"
            android:letterSpacing="0.1"/>

    </LinearLayout>

</RelativeLayout>
