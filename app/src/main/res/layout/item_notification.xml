<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <RelativeLayout
        android:id="@+id/avWrap"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_alignParentStart="true">

        <TextView
            android:id="@+id/avatar"
            style="@style/AvatarText"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:textSize="22sp" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignEnd="@id/avWrap"
        android:layout_alignBottom="@id/avWrap"
        android:layout_marginEnd="-6dp"
        android:layout_marginBottom="-4dp"
        android:background="@drawable/bg_circle">

        <ImageView
            android:id="@+id/badge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_circle"
            android:padding="4dp"
            android:contentDescription="@string/notification_badge" />
    </RelativeLayout>

    <ImageView
        android:id="@+id/more"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentEnd="true"
        android:padding="4dp"
        android:src="@drawable/ic_more"
        app:tint="@color/ink2"
        android:contentDescription="@string/more_icon" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="6dp"
        android:layout_toStartOf="@id/more"
        android:layout_toEndOf="@id/avWrap"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnConfirm"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_teal12"
                android:gravity="center"
                android:text="@string/confirm"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_gray12"
                android:gravity="center"
                android:text="@string/delete"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
