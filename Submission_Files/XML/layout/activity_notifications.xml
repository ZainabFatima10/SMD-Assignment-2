                android:src="@drawable/ic_thumb_fill"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/n6_more"
                android:layout_width="30dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="6dp"
