                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="2d"
                    android:textColor="@color/ink2"
                    android:textSize="15sp"
                    android:textStyle="normal" />
            </LinearLayout>
