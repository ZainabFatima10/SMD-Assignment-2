<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <include layout="@layout/tabbar_notif" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="5dp"
            android:gravity="center_vertical"
            android:letterSpacing="-0.02"
            android:text="New"
            android:textColor="@color/ink"
            android:textSize="23sp"
            android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/teal_light"
                android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/n1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="84dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="11dp">

            <TextView
                android:id="@+id/n1_av"
                style="@style/AvatarText"
                android:layout_width="63dp"
                android:layout_height="63dp"
                android:backgroundTint="#A23B52"
                android:text="AK"
                android:textSize="27sp" />

            <ImageView
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:layout_alignEnd="@id/n1_av"
                android:layout_alignBottom="@id/n1_av"
                android:layout_marginEnd="-3dp"
                android:layout_marginBottom="-4dp"
                android:background="@drawable/bg_circle"
                android:padding="5dp"
                android:src="@drawable/ic_heart"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/n1_badge"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_alignEnd="@id/n1_av"
                android:layout_alignBottom="@id/n1_av"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="-1dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#D8344F"
                android:padding="5dp"
                android:src="@drawable/ic_heart"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/n1_more"
                android:layout_width="30dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="6dp"
                android:padding="2dp"
                android:src="@drawable/ic_more"
                android:tint="#6F6A63" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@id/n1_more"
                android:layout_toEndOf="@id/n1_av"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/n1_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="Aisha Khan and 32 others reacted&#10;to your photo."
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="5m"
                    android:textColor="@color/teal"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/n2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/n2_av"
                style="@style/AvatarText"
                android:layout_width="63dp"
                android:layout_height="63dp"
                android:backgroundTint="#4B4F93"
                android:text="SI"
                android:textSize="27sp" />

            <ImageView
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:layout_alignEnd="@id/n2_av"
                android:layout_alignBottom="@id/n2_av"
                android:layout_marginEnd="-3dp"
                android:layout_marginBottom="-4dp"
                android:background="@drawable/bg_circle"
                android:padding="5dp"
                android:src="@drawable/ic_person"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/n2_badge"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_alignEnd="@id/n2_av"
                android:layout_alignBottom="@id/n2_av"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="-1dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#0B5F61"
                android:padding="5dp"
                android:src="@drawable/ic_person"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/n2_more"
                android:layout_width="30dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="6dp"
                android:padding="2dp"
                android:src="@drawable/ic_more"
                android:tint="#6F6A63" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@id/n2_more"
                android:layout_toEndOf="@id/n2_av"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/n2_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="Sara Iqbal sent you a friend&#10;request."
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="20m"
                    android:textColor="@color/teal"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/actions"
                android:layout_width="match_parent"
                android:layout_height="37dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnConfirm"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_teal12"
                    android:gravity="center"
                    android:text="Confirm"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnDelete"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cream12"
                    android:gravity="center"
                    android:text="Delete"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
            </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="5dp"
            android:gravity="center_vertical"
            android:letterSpacing="-0.02"
            android:text="Earlier"
            android:textColor="@color/ink"
            android:textSize="23sp"
            android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

        <RelativeLayout
