                android:layout_alignBottom="@id/n4_av"
                android:layout_marginEnd="-3dp"
                android:layout_marginBottom="-4dp"
                android:background="@drawable/bg_circle"
                android:padding="5dp"
                android:src="@drawable/ic_people"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/n4_badge"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_alignEnd="@id/n4_av"
                android:layout_alignBottom="@id/n4_av"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="-1dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#4B4F93"
                android:padding="5dp"
                android:src="@drawable/ic_people"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/n4_more"
                android:layout_width="30dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="6dp"
                android:padding="2dp"
                android:src="@drawable/ic_more"
                android:tint="#6F6A63" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@id/n4_more"
                android:layout_toEndOf="@id/n4_av"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/n4_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="New post in SMD Class of 2026:&#10;“Assignment 1 is out. Start early.”"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="5h"
                    android:textColor="@color/ink2"
                    android:textSize="15sp"
                    android:textStyle="normal" />
            </LinearLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/n5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="84dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="11dp">

            <TextView
                android:id="@+id/n5_av"
                style="@style/AvatarText"
                android:layout_width="63dp"
                android:layout_height="63dp"
                android:backgroundTint="#8B5A2B"
                android:text="HA"
                android:textSize="27sp" />

            <ImageView
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:layout_alignEnd="@id/n5_av"
                android:layout_alignBottom="@id/n5_av"
                android:layout_marginEnd="-3dp"
                android:layout_marginBottom="-4dp"
                android:background="@drawable/bg_circle"
                android:padding="5dp"
                android:src="@drawable/ic_tag"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/n5_badge"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_alignEnd="@id/n5_av"
                android:layout_alignBottom="@id/n5_av"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="-1dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#C98A12"
                android:padding="5dp"
                android:src="@drawable/ic_tag"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/n5_more"
                android:layout_width="30dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="6dp"
                android:padding="2dp"
                android:src="@drawable/ic_more"
                android:tint="#6F6A63" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@id/n5_more"
                android:layout_toEndOf="@id/n5_av"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/n5_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="Hamza Ali tagged you in a post."
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Yesterday"
                    android:textColor="@color/ink2"
                    android:textSize="15sp"
                    android:textStyle="normal" />
            </LinearLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/n6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="84dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="11dp">

            <TextView
                android:id="@+id/n6_av"
                style="@style/AvatarText"
                android:layout_width="63dp"
                android:layout_height="63dp"
                android:backgroundTint="#7B4F7F"
                android:text="LM"
                android:textSize="27sp" />

            <ImageView
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:layout_alignEnd="@id/n6_av"
                android:layout_alignBottom="@id/n6_av"
                android:layout_marginEnd="-3dp"
                android:layout_marginBottom="-4dp"
                android:background="@drawable/bg_circle"
                android:padding="5dp"
                android:src="@drawable/ic_thumb_fill"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/n6_badge"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_alignEnd="@id/n6_av"
                android:layout_alignBottom="@id/n6_av"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="-1dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#0B5F61"
