<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/RL1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/one_sided_black_border">

        <TextView
            android:id="@+id/recents_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recents"
            android:textColor="@color/black"
            android:layout_marginStart="150dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/logo_text_bold"
            android:textSize="15sp"
            android:layout_marginBottom="10dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"/>

        <ImageView
            android:layout_alignStart="@id/recents_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_down"
            android:layout_marginStart="80dp"
            android:layout_marginTop="5dp"
            android:scaleY="0.8"
            android:scaleX="0.8"
            android:contentDescription="@string/most_relevant"/>

        <TextView
            android:id="@+id/cancel_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:textColor="@color/black"
            android:layout_alignParentStart="true"
            android:layout_marginStart="15dp"
            android:layout_marginTop="15dp" />

        <TextView
            android:id="@+id/most_relevant_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/next_2"
            android:textColor="@color/SeaGreen"
            android:textStyle="bold"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="15dp"
            android:layout_marginTop="13dp"
            android:layout_marginEnd="15dp"/>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/current_picture"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_alignTop="@id/RL1"
        android:layout_marginTop="50dp">

        <ImageView
            android:id="@+id/previewImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/extra1"
            android:scaleType="centerCrop"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:src="@drawable/scan_icon"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/scan_button_background"/>

        <Button
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/button_border_log_in"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp"
            android:id="@+id/btnSelectMultiple"
        android:text="Select Multiple"
            android:paddingEnd="20dp"
            android:drawableStart="@drawable/copy_icon"
            android:drawablePadding="10dp"
            android:paddingStart="20dp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textAlignment="textEnd"/>


    </RelativeLayout>

